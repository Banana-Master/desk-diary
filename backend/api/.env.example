# 실행 모드 (development일 때 HTTP 요청 로깅 활성화)
MODE=development

# MySQL (Prisma) - Amazon RDS 등 MySQL 접속 URL
RDS_DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# MongoDB (Mongoose) 접속 URL
MONGO_URL=mongodb://localhost:27017/desk-diary

# socket 서버와 통신할 때 사용하는 공유 시크릿 키 (backend/socket과 동일한 값이어야 함)
SOCKET_SECRET_KEY=

# JWT
JWT_SECRET=
JWT_EXPIRATION_TIME=1y
JWT_REFRESH_SECRET=

# AWS S3 (프로필/방 썸네일 이미지 업로드)
AWS_REGION=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET_NAME=

# Agora (화상/음성 통화)
AGORA_APP_CERTIFICATE=

# 카카오 소셜 로그인
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=http://localhost:4000/auth/kakao/callback

# 구글 소셜 로그인
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
