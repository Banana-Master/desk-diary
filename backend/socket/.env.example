# MongoDB (Mongoose) 접속 URL
MONGO_URL=mongodb://localhost:27017/desk-diary

# backend/api 서버 주소 (내부 API 호출용)
API_SERVER_URL=http://localhost:4000

# api 서버와 통신할 때 사용하는 공유 시크릿 키 (backend/api와 동일한 값이어야 함)
SOCKET_SECRET_KEY=

# Redis (socket.io 어댑터)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
