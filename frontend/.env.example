# backend/api 서버 주소
REACT_APP_SERVER_URL=http://localhost:4000

# backend/socket 서버 주소 - 운영에서는 nginx가 /socket.io/ 경로만 소켓 서버로
# 프록시해주지만, 로컬은 api/socket이 별도 포트라 직접 지정해야 함
REACT_APP_SOCKET_URL=http://localhost:4001

# 카카오 소셜 로그인
REACT_APP_KAKAO_CLIENT_ID=

# 구글 소셜 로그인
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
REACT_APP_GOOGLE_SCOPE_PROFILE=https://www.googleapis.com/auth/userinfo.profile
REACT_APP_GOOGLE_SCOPE_EMAIL=https://www.googleapis.com/auth/userinfo.email
